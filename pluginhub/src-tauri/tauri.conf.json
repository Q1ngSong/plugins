{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "插件中心",
  "mainBinaryName": "pluginhub",
  "version": "1.2.0",
  "identifier": "com.yuwan.pluginhub",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build:renderer"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"]
      }
    }
  }
}
